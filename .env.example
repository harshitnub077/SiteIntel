# FieldAI Master Environment Variables

# --- SUPABASE (Database & Auth) ---
# Create a new project at https://supabase.com
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# --- OPENAI (RAG, Vision, Whisper) ---
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key"

# --- CLOUDFLARE R2 (Photo & PDF Storage) ---
# Get these from your Cloudflare Dashboard -> R2 -> Manage API tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="fieldai-assets"

# --- STRIPE (Billing - Milestone 3) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
