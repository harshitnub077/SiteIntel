<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; padding: 40px; color: #333; }
        .header { border-bottom: 2px solid #000; padding-bottom: 20px; margin-bottom: 30px; }
        .header h1 { margin: 0; font-size: 28px; }
        .header p { margin: 5px 0 0 0; color: #666; }
        .defect { page-break-inside: avoid; border: 1px solid #e0e0e0; border-radius: 8px; margin-bottom: 20px; padding: 20px; }
        .defect-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .defect-title { font-size: 20px; font-weight: bold; margin: 0; }
        .severity { padding: 4px 12px; border-radius: 20px; font-weight: bold; font-size: 12px; text-transform: uppercase; }
        .severity.high { background: #fee2e2; color: #991b1b; }
        .severity.med { background: #fef3c7; color: #92400e; }
        .severity.low { background: #dcfce7; color: #166534; }
        .severity.critical { background: #7f1d1d; color: #fff; }
        .details p { margin: 5px 0; font-size: 14px; }
        .photo { max-width: 100%; height: auto; border-radius: 4px; margin-top: 15px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>FieldAI Inspection Report</h1>
        <p>Report ID: {{inspectionId}} | Date: {{date}}</p>
    </div>

    {{#if defects.length}}
        {{#each defects}}
        <div class="defect">
            <div class="defect-header">
                <h2 class="defect-title">{{ai_label}}</h2>
                <span class="severity {{severity}}">{{severity}}</span>
            </div>
            <div class="details">
                <p><strong>Location:</strong> {{location_tag}}</p>
                <p><strong>Captured At:</strong> {{created_at}}</p>
            </div>
            {{#if photo_url}}
            <img class="photo" src="{{photo_url}}" alt="Defect Photo">
            {{/if}}
        </div>
        {{/each}}
    {{else}}
        <p>No defects recorded in this inspection.</p>
    {{/if}}
</body>
</html>
